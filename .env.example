# -----------------------------------------------------------------------------
# Bensaid Mek Énergie — environment variables
# Copy this file to `.env.local` for local development, and set the same
# variables in your hosting provider (e.g. Vercel → Project → Settings →
# Environment Variables) for production. Never commit real secrets.
# -----------------------------------------------------------------------------

# Public base URL of the website, WITH protocol and WITHOUT trailing slash.
# Used for canonical URLs, sitemap.xml, robots.txt, Open Graph and JSON-LD.
# Falls back to `website` in src/config/company.ts, then the Vercel URL,
# then http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# --- Quote form delivery (choose ONE option) ---------------------------------

# Option A — Email via Resend (https://resend.com)
# RESEND_API_KEY: API key from the Resend dashboard (secret).
# QUOTE_TO_EMAIL: recipient(s) of quote requests, comma-separated.
# QUOTE_FROM_EMAIL: verified sender, e.g. "Bensaid Mek Énergie <devis@votre-domaine.ma>".
#                   Defaults to Resend's onboarding sender (testing only).
RESEND_API_KEY=
QUOTE_TO_EMAIL=
QUOTE_FROM_EMAIL=

# Option B — Webhook (Make, Zapier, n8n, Formspree, a CRM endpoint…)
# Receives a JSON POST: { type, source, submittedAt, name, company, phone,
# email, need, needLabel, message }.
QUOTE_WEBHOOK_URL=

# Without any delivery option: requests are only logged to the server console
# in development; in production the form shows an error inviting visitors to
# call, so no request is silently lost.
